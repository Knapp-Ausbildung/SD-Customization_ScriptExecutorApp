{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux: ScriptExecutorApp",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Windows: ScriptExecutorApp (MSYS2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "stopAtEntry": false,
      "externalConsole": false,
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\mingw64\\bin;${env:PATH}"
        },
        {
          "name": "QT_PLUGIN_PATH",
          "value": "C:\\msys64\\mingw64\\share\\qt6\\plugins"
        }
      ]
    }
  ]
}
