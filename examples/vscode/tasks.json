{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "Linux (WSL): Configure",
			"command": "cmake",
			"args": ["--preset", "linux-dev"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Linux (WSL): Build",
			"command": "cmake",
			"args": ["--build", "--preset", "linux-dev", "--parallel"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Linux (WSL): Launch",
			"command": "${workspaceFolder}/build/linux-dev/ScriptExecutorApp",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Linux (WSL): Build and launch",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Linux (WSL): Configure",
				"Linux (WSL): Build",
				"Linux (WSL): Launch"
			],
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows: Configure (MSYS2)",
			"command": "C:\\msys64\\mingw64\\bin\\cmake.exe",
			"args": ["--preset", "windows-mingw64"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Windows: Build (MSYS2)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Windows: Configure (MSYS2)",
				"Windows: Build app (MSYS2)"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows: Build app (MSYS2)",
			"command": "C:\\msys64\\mingw64\\bin\\cmake.exe",
			"args": ["--build", "--preset", "windows-mingw64", "--parallel"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Windows: Package (MSYS2)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Windows: Configure (MSYS2)",
				"Windows: Create package (MSYS2)"
			],
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows: Create package (MSYS2)",
			"command": "C:\\msys64\\mingw64\\bin\\cmake.exe",
			"args": ["--build", "--preset", "windows-mingw64-package", "--parallel"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Windows: Package and launch (MSYS2)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Windows: Package (MSYS2)",
				"Windows: Launch package (MSYS2)"
			],
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows: Launch package (MSYS2)",
			"command": "${workspaceFolder}\\build\\windows-mingw64\\windows-package\\ScriptExecutorApp.exe",
			"options": {
				"cwd": "${workspaceFolder}\\build\\windows-mingw64\\windows-package"
			},
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows (WSL): Configure",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/windows-build-from-wsl.sh", "configure"],
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows (WSL): Build",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/windows-build-from-wsl.sh", "build"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows (WSL): Package",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/windows-build-from-wsl.sh", "package"],
			"problemMatcher": []
		},
		{
			"type": "process",
			"label": "Windows (WSL): Package and launch",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/windows-build-from-wsl.sh", "launch"],
			"problemMatcher": []
		}
	]
}
